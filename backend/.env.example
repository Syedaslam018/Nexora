# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora?schema=public

# --- Redis (cache / sessions / rate-limit / BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string_dev_only
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_another_long_random_string_dev_only

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Email ---
# EMAIL_PROVIDER=mock uses the in-repo mock transport (logs emails, sends nothing)
EMAIL_PROVIDER=mock
EMAIL_FROM="NEXORA <no-reply@nexora.dev>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
