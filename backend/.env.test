# Dummy values satisfying config/env.ts's Zod schema so `npm test` (unit
# tests) can import service modules without needing real secrets — nothing
# here is a real credential, and this file is safe to commit. Integration
# tests still need a real DATABASE_URL pointing at a disposable test
# Postgres — see tests/integration/README.md.
NODE_ENV=test
PORT=4001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4001
DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora_test?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=test_jwt_secret_at_least_16_chars
JWT_REFRESH_SECRET=test_refresh_secret_at_least_16_chars
COOKIE_SECRET=test_cookie_secret_at_least_16_chars
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummy
EMAIL_PROVIDER=mock
