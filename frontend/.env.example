# Dev leaves this unset — Vite's proxy (vite.config.ts) forwards /api to the
# backend, so no base URL is needed locally. Set this for a deployed build
# pointing at a separately-hosted API.
VITE_API_URL=

VITE_SOCKET_URL=

# Stripe TEST MODE publishable key (starts with pk_test_) — safe to expose
# client-side by design. Get it from the same Stripe account whose secret
# key is in backend/.env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
